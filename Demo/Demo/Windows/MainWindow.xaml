<Window x:Class="Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Demo"
        mc:Ignorable="d"
        Title="Каталог товаров" Icon="/Recourses/Icon.ico" WindowState="Maximized" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Background="#7FFF00">
            <Image Source="/Recourses/Icon.png" HorizontalAlignment="Left"/>
            <TextBlock Text="ООО «Обувь»" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Button Content="Войти" x:Name="login" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="login_Click"/>
            <Button Content="Выйти" x:Name="back" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="back_Click"/>
            <TextBlock x:Name="name_tb" VerticalAlignment="Top" HorizontalAlignment="Right"/>
        </Grid>
        <Grid Grid.Row="1">
            <TextBlock Text="Поиск:" VerticalAlignment="Center" HorizontalAlignment="Left"/>
            <TextBox x:Name="search" HorizontalAlignment="Left" Margin="49,0,0,0" Width="150" Height="35" VerticalAlignment="Bottom" TextChanged="search_TextChanged"/>
            <TextBlock Text="Сортировка:"  VerticalAlignment="Center" HorizontalAlignment="Left"  Margin="220 0 0 0"/>
            <ComboBox x:Name="sort" Width="170" SelectionChanged="sort_SelectionChanged">
                <ComboBoxItem>По количеству (возрастание)</ComboBoxItem>
                <ComboBoxItem>По количеству (убывание)</ComboBoxItem>
            </ComboBox>
            <TextBlock Text="Фильтр:"  VerticalAlignment="Center" HorizontalAlignment="Right"  Margin="0 0 180 0"/>
            <ComboBox x:Name="filter" HorizontalAlignment="Right" Width="170" SelectionChanged="filter_SelectionChanged">
            </ComboBox>
        </Grid>
        
        <ListView x:Name="tovar_lv" Grid.Row="2" HorizontalContentAlignment="Stretch">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical"/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
        </ListView>
        <TextBlock Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" x:Name="notTovar" Text=""/>
    </Grid>
</Window>
