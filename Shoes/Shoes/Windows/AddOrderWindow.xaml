<Window x:Class="Shoes.Windows.AddOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Shoes.Windows"
        mc:Ignorable="d"
        Title="Добавление/редактирование заказа" Height="650" Width="900" Icon="/Resources/Icon.ico"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="75"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Grid Background="#7FFF00">
            <Image Source="/Resources/Icon.png" HorizontalAlignment="Left" Width="50" Height="50" Margin="5"/>
            <TextBlock Text="ООО «Обувь»" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <Button x:Name="back_btn" Content="Выйти" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="3" Margin="0,5,10,0" Click="back_btn_Click"/>
            <Button x:Name="backMain_btn" Content="Назад" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,70,0" Padding="3" Click="backMain_btn_Click"/>
            <TextBlock x:Name="name_tb" HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="3"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    
                        <StackPanel>
                            <TextBlock Text="ТОВАРЫ В ЗАКАЗЕ" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                            <TextBlock Text="Выберите товар:" Margin="0,5,0,0"/>
                            <ComboBox x:Name="cmbTovar" Height="30" Margin="0,2,0,5"/>

                            <TextBlock Text="Количество:" Margin="0,5,0,0"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="txtQuantity" Width="100" Height="30" Text="1"/>
                                <Button x:Name="btnAddTovar" Content="Добавить" Width="80" Height="30" Margin="5,0,0,0" Click="btnAddTovar_Click"/>
                            </StackPanel>

                            <TextBlock Text="Добавленные товары:" Margin="0,10,0,5"/>
                        <ListBox x:Name="lstOrderTovars" Height="150" Margin="0,0,0,5" DisplayMemberPath="DisplayText"/>
                        <Button x:Name="btnRemoveTovar" Content="Удалить выбранный" Width="150" Height="30" Click="btnRemoveTovar_Click"/>
                        </StackPanel>
                   
                </StackPanel>

                <!-- Правая колонка - Информация о заказе -->
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    
                        <StackPanel>
                            <TextBlock Text="ИНФОРМАЦИЯ О ЗАКАЗЕ" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                            <!-- Код заказа -->
                            <TextBlock Text="Код заказа:" Margin="0,5,0,0"/>
                            <TextBox x:Name="txtOrderCode" Height="30" Margin="0,2,0,5" IsReadOnly="True" Background="#F0F0F0"/>

                            <!-- Статус -->
                            <TextBlock Text="Статус заказа:" Margin="0,5,0,0"/>
                            <ComboBox x:Name="cbStatus" Height="30" Margin="0,2,0,5"/>

                            <!-- Пункт выдачи -->
                            <TextBlock Text="Пункт выдачи:" Margin="0,5,0,0"/>
                            <ComboBox x:Name="cmbPickUpPoint" Height="30" Margin="0,2,0,5" DisplayMemberPath="FullAddress"/>

                            <!-- Даты -->
                            <TextBlock Text="Дата заказа:" Margin="0,5,0,0"/>
                            <DatePicker x:Name="dateOrder" Height="30" Margin="0,2,0,5"/>

                            <TextBlock Text="Дата доставки:" Margin="0,5,0,0"/>
                            <DatePicker x:Name="dateDelivery" Height="30" Margin="0,2,0,5"/>

                            <!-- Кнопка сохранения -->
                            <Button x:Name="SaveGood" Content="СОХРАНИТЬ ЗАКАЗ" Height="40" Margin="0,20,0,0" 
                                    Click="SaveGood_Click" Background="#7FFF00" FontWeight="Bold"/>
                        </StackPanel>
                    
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>