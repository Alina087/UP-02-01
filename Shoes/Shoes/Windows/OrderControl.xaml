<UserControl x:Class="Shoes.Windows.OrderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Shoes.Windows"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Border Margin="10" Padding="5" BorderBrush="#00FA9A" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="{Binding OrderCode, StringFormat='Артикул заказа: {0}'}"/>
                    <TextBlock Text="{Binding OrderStatus, StringFormat='Статс заказа: {0}'}"/>
                    <TextBlock Text="{Binding Adres}"/>
                    <TextBlock Text="{Binding OrderDate, StringFormat='Дата заказа: {0:dd.MM.yyyy}'}"/>
                    
                   
                </StackPanel>

                <TextBlock Text="{Binding OrderDateDelivery, StringFormat='Дата доставки: {0:dd.MM.yyyy}'}" Grid.Column="2" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
