<UserControl x:Class="Shoes.Windows.TovarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Shoes.Windows"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border Margin="10" Padding="5" BorderBrush="#00FA9A" BorderThickness="1" Background="{Binding BackgroundColor}">
        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="105"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Image Source="{Binding DisplayImage}" Grid.Column="0" Stretch="Uniform"  Width="100" Height="100" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <StackPanel Orientation="Vertical" Grid.Column="1">
            <TextBlock Text="{Binding Title}"/>
            <TextBlock Text="{Binding TovarDescription, StringFormat='Описание товара: {0}'}"/>
            <TextBlock Text="{Binding Manufacturer.ManufacturerName, StringFormat='Производитель: {0}'}"/>
            <TextBlock Text="{Binding Supplier.SupplierName, StringFormat='Поставщик: {0}'}"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="{Binding TovarCost, StringFormat='Цена: {0:F2}₽'}"
                           Foreground="{Binding PriceColor}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasDiscount}" Value="True">
                                        <Setter Property="TextDecorations" Value="Strikethrough"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="{Binding FinalPrice, StringFormat=' → {0:F2}₽'}"
                           FontWeight="Bold"
                           Margin="5,0,0,0"
                           Visibility="{Binding HasDiscount}"/>
                </StackPanel>
                <TextBlock Text="{Binding TovarUnit, StringFormat='Единица измерения: {0}'}"/>
            <TextBlock Text="{Binding TovarCount, StringFormat='Количество на складе: {0}'}"/>
        </StackPanel>

        <TextBlock Text="{Binding TovarDiscount, StringFormat='Действующая скидка: {0}%'}" Grid.Column="2" VerticalAlignment="Center"/>
    </Grid>
    </Border>
    
</UserControl>
