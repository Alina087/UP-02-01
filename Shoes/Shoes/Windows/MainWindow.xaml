<Window x:Class="Shoes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Shoes"
        mc:Ignorable="d"
        Title="Авторизация пользователя" Height="450" Width="800" Icon="/Resources/Icon.ico" WindowState="Maximized">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="1.7*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="0.3*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="1.7*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Авторизация" Grid.Row="1" FontSize="24" HorizontalAlignment="Center"/>
            <TextBlock Text="Введите логин" Grid.Row="2" FontSize="16"/>
            <TextBox x:Name="login_txt" Grid.Row="3"/>
            <TextBlock Text="Введите пароль" Grid.Row="4" FontSize="16"/>
            <TextBox x:Name="pass_txt" Grid.Row="5"/>
            <Button x:Name="gost_btn" Grid.Row="6" HorizontalAlignment="Left" Content="Войти как гость" Height="45" Margin="0,13,0,0" Grid.RowSpan="3" VerticalAlignment="Top" Click="gost_btn_Click"/>
            <Button x:Name="enter_btn" Grid.Row="7" HorizontalAlignment="Right" Content="Войти" Click="enter_btn_Click" VerticalAlignment="Top" Height="45"/>
        </Grid>

    </Grid>
</Window>
