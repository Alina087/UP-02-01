<Window x:Class="Shoes.Windows.AddTovarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Shoes.Windows"
        mc:Ignorable="d"
        Title="Добавление/редактирование товара" Height="550" Width="800" Icon="/Resources/Icon.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="75"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Background="#7FFF00">
            <Image Source="/Resources/Icon.png" HorizontalAlignment="Left" Width="50" Height="50"/>
            <TextBlock Text="ООО «Обувь»" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <Button x:Name="back_btn" Content="Выйти" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="3" Click="back_btn_Click"/>
            <Button x:Name="backMain_btn" Content="Назад" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0 0 60 0" Padding="3" Click="backMain_btn_Click"/>
            <TextBlock x:Name="name_tb" HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="3"/>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Vertical" Grid.Column="0" Margin="10">
                <TextBlock Width="250">Артикул товара</TextBlock>
                <TextBox Width="250" x:Name="article" IsEnabled="False"></TextBox>
                <TextBlock Width="250" Margin="0,10,0,0">Фото товара</TextBlock>
                <Button Width="250" Content="Выбрать фото" Margin="0 6 0 6" x:Name="add_image" Click="add_image_Click"></Button>
                <Image Width="300" Height="200" Stretch="Uniform" x:Name="image" Source="/Resources/picture.png"></Image>
                <TextBlock Width="250" Margin="0,10,0,0">Название</TextBlock>
                <TextBox Width="250" x:Name="name"></TextBox>
                <TextBlock Width="250" Margin="0,10,0,0">Категория</TextBlock>
                <ComboBox Width="250" x:Name="cbCategories"></ComboBox>
            </StackPanel>
            <StackPanel Orientation="Vertical" Grid.Column="1" Margin="10">
                
                <TextBlock Width="250" Margin="0,10,0,0">Описание</TextBlock>
                <TextBox Width="250" Height="60" x:Name="description" TextWrapping="Wrap" AcceptsReturn="True"></TextBox>
                <TextBlock Width="250">Производитель</TextBlock>
                <ComboBox Width="250" x:Name="manufacturer"></ComboBox>
                <TextBlock Width="250" Margin="0,10,0,0">Поставщик</TextBlock>
                <ComboBox Width="250" x:Name="delivery"></ComboBox>
                <TextBlock Width="250" Margin="0,10,0,0">Цена</TextBlock>
                <TextBox Width="250" x:Name="cost"></TextBox>
                <TextBlock Width="250" Margin="0,10,0,0">Единица измерения</TextBlock>
                <ComboBox Width="250" x:Name="unit">
                    <ComboBoxItem>шт.</ComboBoxItem>
                </ComboBox>
                <TextBlock Width="250" Margin="0,10,0,0">Кол-во на складе</TextBlock>
                <TextBox Width="250" x:Name="quantity"></TextBox>
                <TextBlock Width="250" Margin="0,10,0,0">Действующая скидка</TextBlock>
                <TextBox Width="250" x:Name="discount"></TextBox>
                <Button Width="250" Margin="0,20,0,0" x:Name="SaveGood" Click="SaveGood_Click">Сохранить</Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>