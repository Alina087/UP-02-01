<Window x:Class="Shoes.Windows.OrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Shoes.Windows"
        mc:Ignorable="d"
            Title="Заказы" Height="450" Width="800" Icon="/Resources/Icon.ico" WindowState="Maximized">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="75"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Background="#7FFF00">
            <Image Source="/Resources/Icon.png" HorizontalAlignment="Left"/>
            <TextBlock Text="ООО «Обувь»" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <Button x:Name="login_btn" Content="Войти" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="3" Click="login_btn_Click"/>
            <Button x:Name="back_btn" Content="Выйти" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="3" Click="back_btn_Click"/>
            <Button x:Name="add_btn" Content="Добавить заказ" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0 0 60 0" Padding="3" Click="add_btn_Click"/>
            <Button x:Name="tovar_btn" Content="Товары" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0 0 175 0" Padding="3" Click="tovar_btn_Click"/>
            <TextBlock x:Name="name_tb" HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="3"/>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            
        </Grid>
        <ListView x:Name="order_lv" HorizontalContentAlignment="Stretch" Grid.Row="1">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical"/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ContextMenu>
                <ContextMenu Name="menu">
                    <MenuItem x:Name="redact" Header="Редактировать" Click="redact_Click"/>
                    <MenuItem x:Name="delete" Header="Удалить" Click="delete_Click"/>
                </ContextMenu>
            </ListView.ContextMenu>
        </ListView>
    </Grid>
</Window>
