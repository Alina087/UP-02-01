<UserControl x:Class="Demo.Windows.TovarControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Demo.Windows"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border BorderThickness="1" BorderBrush="#00FA9A" Background="{Binding Color}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="170"/>
            </Grid.ColumnDefinitions>
            <Image Source="{Binding Photo}" Width="100" Height="100" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform"/>
            <StackPanel Grid.Column="1" Orientation="Vertical">
                <TextBlock Text="{Binding CategoryName}"/>
                <TextBlock Text="{Binding TovarDescription, StringFormat='Описание товара: {0}'}"/>
                <TextBlock Text="{Binding Manufacturer.ManufacturerId, StringFormat='Производитель: {0}'}"/>
                <TextBlock Text="{Binding Supplier.SupplierId, StringFormat='Поставщик: {0}'}"/>
                <TextBlock Text="{Binding TotalCost, StringFormat='Цена: {0}₽'}"/>
                <TextBlock Text="{Binding TovarUnit, StringFormat='Единица измрения: {0}'}"/>
                <TextBlock Text="{Binding TovarCount, StringFormat='Колиество на складе: {0}'}"/>
            </StackPanel>
            <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center" Text="{Binding TovarDiscount, StringFormat='Действующая скидка: {0}%'}"/>
        </Grid>
    </Border>
    
</UserControl>
